# QPMIL-VL is vendored (committed) — it's a hard dependency we patched (configs/main.yaml).
# Upstream: https://github.com/can-can-ya/QPMIL-VL.git @ 3a7a769. Large weights stay ignored via *.bin / checkpoints/.
.env
__pycache__/
*.pyc
checkpoints/
*.bin
.DS_Store
data
# results live in outputs/ (tracked). small .pt (<=5MB) kept in git;
# the only large weights are CONCH at checkpoints/*.bin (still ignored above).
outputs/_smoke/
# outputs_history/ keeps report evidence (json/log/png, already tracked) but NOT
# the redundant .pt duplicates of canonical weights that live in outputs/.
outputs_history/**/*.pt
# session_archive/ holds local Cursor chat transcripts (private, large) — ignored.
# The README in there IS tracked so the backup/restore guide lives in git.
session_archive/*.jsonl
session_archive/*.zip
# LaTeX local build dir (artifacts + LNCS class files come from Overleaf/MICCAI)
paper/_build/
